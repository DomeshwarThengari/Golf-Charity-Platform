# Server Port
PORT=5000

# Client App URL for CORS Configuration
CLIENT_URL=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authorization Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Integration for Media Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Subscriptions Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_MONTHLY_PRICE_ID=price_monthly_id
STRIPE_YEARLY_PRICE_ID=price_yearly_id
STRIPE_MONTHLY_AMOUNT=250
STRIPE_YEARLY_AMOUNT=2500
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SMTP Mail Server Configuration (Brevo/SendGrid/etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@yourdomain.com
